{
  "name": "unsmurf",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://ns-rot.github.io/unsmurf",
  "type": "module",
  "scripts": {
    "build": "npm run build:css && rollup -c",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/build/tailwind.css",
    "dev": "concurrently \"npm run dev:css\" \"rollup -c -w\"",
    "dev:css": "tailwindcss -i ./src/input.css -o ./public/build/tailwind.css --watch",
    "start": "sirv public --no-clear",
    "deploy": "npm run build && gh-pages -d public",
    "aggregate": "node aggregateData.js"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^24.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "eslint": "^9.19.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.1",
    "postcss-load-config": "^6.0.1",
    "rollup": "^3.15.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-css-only": "^4.3.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-svelte": "^7.2.2",
    "svelte": "^5.19.1",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "hyphenation.de": "^0.2.1",
    "hyphenation.en-us": "^0.2.1",
    "hyphenation.fr": "^0.2.1",
    "hypher": "^0.2.5",
    "node-fetch": "^2.6.7",
    "sirv-cli": "^2.0.0"
  }
}